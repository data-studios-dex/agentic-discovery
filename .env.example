# Database Connection URL (SQLite default demo)
DB_URL=sqlite:///sample/sample.db
DB_SCHEMA=main

# LLM Mode: "offline" (deterministic engine), "api" (direct Anthropic Messages API), or "managed" (Claude Managed Agents)
LLM_MODE=offline
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5

# Managed Agents Control Plane
MANAGED_AGENTS_REGISTRY=managed_agents.json
MANAGED_SESSION_TIMEOUT=600
MANAGED_MAX_ATTEMPTS=2
MANAGED_MAX_CONCURRENT_SESSIONS=4

# Connections File
DISCOVERY_CONNECTIONS_FILE=connections.json
